{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // Pages go through the worker so an unknown address answers 404; built files skip it.
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*", "!/favicon.svg"]
  },
  "compatibility_date": "2026-09-01",
  "dev": {
    "port": 8790
  },
  "durable_objects": {
    "bindings": [{ "class_name": "FamilyRoom", "name": "FAMILY_ROOMS" }]
  },
  "main": "src/index.ts",
  // The free plan only offers Durable Objects backed by SQLite.
  "migrations": [{ "new_sqlite_classes": ["FamilyRoom"], "tag": "v1" }],
  "name": "arbor",
  "observability": { "enabled": true },
  "routes": [{ "custom_domain": true, "pattern": "arbor.adrienlcp.com" }],
  "workers_dev": false
}
