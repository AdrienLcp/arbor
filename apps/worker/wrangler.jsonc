{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // Pages go through the worker so an unknown address answers 404; built files skip it.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/fonts/*",
      "!/favicon.svg",
      "!/favicon.ico",
      "!/apple-touch-icon.png",
      "!/og-image.png",
      "!/robots.txt",
      "!/sitemap.xml"
    ]
  },
  "compatibility_date": "2026-09-01",
  "dev": {
    "port": 8790
  },
  "durable_objects": {
    "bindings": [{ "class_name": "FamilyRoom", "name": "FAMILY_ROOMS" }]
  },
  "main": "src/index.ts",
  // The free plan only offers Durable Objects backed by SQLite.
  // v2 erased every family when ids changed format; Cloudflare applied it from a
  // deploy that had no FamilyRoom, as a class still bound cannot be deleted.
  "migrations": [
    { "new_sqlite_classes": ["FamilyRoom"], "tag": "v1" },
    { "deleted_classes": ["FamilyRoom"], "tag": "v2" },
    { "new_sqlite_classes": ["FamilyRoom"], "tag": "v3" }
  ],
  "name": "arbor",
  "observability": { "enabled": true },
  "routes": [{ "custom_domain": true, "pattern": "arbor.adrienlcp.com" }],
  // The demo family's photos ride in the bundle as bytes.
  "rules": [{ "fallthrough": true, "globs": ["**/*.webp"], "type": "Data" }],
  // The publisher's key for erasing one person: `wrangler secret put ADMIN_KEY`.
  "secrets": { "required": ["ADMIN_KEY"] },
  "workers_dev": false
}
