{
  "dependencies": {
    "@adrienlcp/result": "^0.1.1",
    "@arbor/core": "workspace:*",
    "@arbor/protocol": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.13",
    "nanoid": "^6.0.2",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.0.2",
    "wrangler": "^4.140.0"
  },
  "name": "@arbor/worker",
  "private": true,
  "scripts": {
    "build": "wrangler types --check && tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "dev": "node -e \"require('node:fs').mkdirSync('../web/dist', { recursive: true })\" && wrangler dev",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
